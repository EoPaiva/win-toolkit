<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="upaiva.dev" Width="1280" Height="800" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
        FontFamily="Segoe UI Variable Text, Segoe UI" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <SolidColorBrush x:Key="Painel" Color="#B80E1320"/>
    <SolidColorBrush x:Key="PainelAlto" Color="#D9141B2B"/>
    <SolidColorBrush x:Key="Borda" Color="#26344A"/>
    <SolidColorBrush x:Key="BordaForte" Color="#3A4B68"/>
    <SolidColorBrush x:Key="Texto" Color="#EEF2F8"/>
    <SolidColorBrush x:Key="Texto2" Color="#AEB8CC"/>
    <SolidColorBrush x:Key="Texto3" Color="#6B7690"/>
    <SolidColorBrush x:Key="Ciano" Color="#22D3EE"/>
    <LinearGradientBrush x:Key="Marca" StartPoint="0,0" EndPoint="1,0.4">
      <GradientStop Color="#22D3EE" Offset="0"/>
      <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MarcaSuave" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#2622D3EE" Offset="0"/>
      <GradientStop Color="#268B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BordaVidro" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4A5F86" Offset="0"/>
      <GradientStop Color="#1C2536" Offset="0.5"/>
      <GradientStop Color="#33415C" Offset="1"/>
    </LinearGradientBrush>

    <!-- Chip de programa -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Chip" CornerRadius="8" Padding="10,7" Background="#0DFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
              <DockPanel>
                <Path x:Name="Marca" DockPanel.Dock="Right" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="#22D3EE" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Hidden"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource MarcaSuave}"/>
                <Setter TargetName="Chip" Property="BorderBrush" Value="#6622D3EE"/>
                <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{StaticResource Texto}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="#22D3EE"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Caixa simples, para titulos e opcoes -->
    <Style x:Key="CaixaTitulo" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Caixa" Width="17" Height="17" CornerRadius="5" Background="#14FFFFFF" BorderBrush="{StaticResource BordaForte}" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Marca" Data="M3.6,8.4 L6.9,11.6 L13,5.2" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Caixa" Property="Background" Value="{StaticResource Marca}"/>
                <Setter TargetName="Caixa" Property="BorderThickness" Value="0"/>
                <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Caixa" Property="BorderBrush" Value="#22D3EE"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoPrincipal" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" CornerRadius="11" Background="{StaticResource Marca}">
              <Border.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="22" ShadowDepth="0" Opacity="0.4"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fundo" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource PainelAlto}"/>
                <Setter TargetName="Fundo" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Foreground" Value="{StaticResource Texto3}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" CornerRadius="9" Background="#12FFFFFF" BorderBrush="{StaticResource BordaForte}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="BorderBrush" Value="#22D3EE"/><Setter TargetName="Fundo" Property="Background" Value="{StaticResource MarcaSuave}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Texto3}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoJanela" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" CornerRadius="7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#1CFFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="3" Background="#1AFFFFFF"/>
              <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{StaticResource Marca}">
                <Border.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="12" ShadowDepth="0" Opacity="0.75"/></Border.Effect>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="#3A4B68" Margin="1,0"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Item do menu lateral: o icone vem da propriedade Tag -->
    <Style x:Key="Aba" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Texto2}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="Fundo" CornerRadius="10" Background="Transparent" Padding="13,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="Icone" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource Texto3}" Width="26"/>
                  <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border x:Name="Barra" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource Marca}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource MarcaSuave}"/>
                <Setter TargetName="Barra" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Icone" Property="Foreground" Value="#22D3EE"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter TargetName="Icone" Property="Foreground" Value="#22D3EE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Perfil" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Fundo" CornerRadius="12" Padding="16,12" BorderThickness="1" BorderBrush="{StaticResource BordaVidro}" Background="{StaticResource Painel}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Fundo" Property="BorderBrush" Value="#22D3EE"/>
                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource MarcaSuave}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="BorderBrush" Value="#22D3EE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="16" Background="#070A12" BorderBrush="#2A3650" BorderThickness="1" ClipToBounds="True">
    <Grid x:Name="FundoHost">
      <Ellipse x:Name="Aurora1" Width="760" Height="620" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-240,0,0" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#3322D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="MoveAurora1"/></Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="Aurora2" Width="820" Height="680" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-280" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#338B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
        <Ellipse.RenderTransform><TranslateTransform x:Name="MoveAurora2"/></Ellipse.RenderTransform>
      </Ellipse>

      <Grid x:Name="Conteudo">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="222"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="#99090D18" BorderBrush="{StaticResource Borda}" BorderThickness="0,0,1,0">
          <DockPanel Margin="14,20,14,16">
            <StackPanel DockPanel.Dock="Top" Margin="6,0,0,22">
              <Grid Width="50" Height="50" HorizontalAlignment="Left">
                <Border CornerRadius="14" Background="{StaticResource Marca}">
                  <Border.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                </Border>
                <TextBlock Text="&gt;_" FontFamily="{StaticResource Mono}" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="upaiva.dev" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Marca}" FontSize="22" FontWeight="Bold" Margin="0,13,0,0"/>
              <TextBlock Text="system toolkit" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto3}" FontSize="11.5" Margin="1,2,0,0"/>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" CornerRadius="11" Background="#0DFFFFFF" BorderBrush="{StaticResource Borda}" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="Pulso" Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock x:Name="Estado" Text="online" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto2}" FontSize="11.5"/>
                </StackPanel>
                <TextBlock x:Name="Host" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto3}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>

            <StackPanel>
              <RadioButton x:Name="AbaInstalar" Style="{StaticResource Aba}" Tag="&#xE896;" Content="Instalar" IsChecked="True" GroupName="Abas"/>
              <RadioButton x:Name="AbaDrivers" Style="{StaticResource Aba}" Tag="&#xE950;" Content="Drivers" GroupName="Abas"/>
              <RadioButton x:Name="AbaAnalisar" Style="{StaticResource Aba}" Tag="&#xEA18;" Content="Analisar" GroupName="Abas"/>
              <RadioButton x:Name="AbaOtimizar" Style="{StaticResource Aba}" Tag="&#xEC4A;" Content="Otimizar" GroupName="Abas"/>
              <RadioButton x:Name="AbaFerramentas" Style="{StaticResource Aba}" Tag="&#xE90F;" Content="Ferramentas" GroupName="Abas"/>
              <RadioButton x:Name="AbaTerminal" Style="{StaticResource Aba}" Tag="&#xE756;" Content="Terminal" GroupName="Abas"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Area principal -->
        <Grid Grid.Column="1" Margin="24,0,20,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid x:Name="Topo" Grid.Row="0" Background="Transparent" Margin="0,18,-6,14">
            <StackPanel>
              <TextBlock x:Name="TituloSecao" Text="Instalar" Foreground="White" FontSize="27" FontWeight="SemiBold"/>
              <TextBlock x:Name="Subtitulo" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ciano}" FontSize="12" Margin="1,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
              <Button x:Name="Minimizar" Style="{StaticResource BotaoJanela}" Content="&#xE921;"/>
              <Button x:Name="Fechar" Style="{StaticResource BotaoJanela}" Content="&#xE8BB;"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="288"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="RolagemGrupos" Grid.Column="0" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Grupos" Margin="0,0,9,0"/>
            </ScrollViewer>

            <DockPanel x:Name="VisaoDrivers" Grid.Column="0" Visibility="Collapsed">
              <Border DockPanel.Dock="Top" CornerRadius="12" Background="{StaticResource Painel}" BorderBrush="{StaticResource BordaVidro}" BorderThickness="1" Padding="16,11" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock x:Name="ResumoDrivers" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ciano}" FontSize="12" Text="driver.scan idle"/>
                  <TextBlock Foreground="{StaticResource Texto3}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0" Text="Fonte: catálogo oficial do Windows Update e ferramentas do fabricante. O catálogo prioriza estabilidade e nem sempre traz a versão mais recente, principalmente de placa de vídeo."/>
                </StackPanel>
              </Border>
              <Button x:Name="InstalarDrivers" DockPanel.Dock="Bottom" Style="{StaticResource BotaoSecundario}" Content="Instalar selecionados" Margin="0,8,0,0" Visibility="Collapsed"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListaDrivers" Margin="0,0,9,0"/>
              </ScrollViewer>
            </DockPanel>

            <DockPanel x:Name="VisaoAnalisar" Grid.Column="0" Visibility="Collapsed">
              <Border DockPanel.Dock="Top" CornerRadius="12" Background="{StaticResource Painel}" BorderBrush="{StaticResource BordaVidro}" BorderThickness="1" Padding="16,11" Margin="0,0,0,8">
                <DockPanel>
                  <CheckBox x:Name="Profundo" Style="{StaticResource CaixaTitulo}" DockPanel.Dock="Right" Content="Profunda (sfc /verifyonly)"/>
                  <TextBlock x:Name="ResumoAnalise" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ciano}" FontSize="12" VerticalAlignment="Center" Text="scanner idle · somente leitura"/>
                </DockPanel>
              </Border>
              <Button x:Name="Corrigir" DockPanel.Dock="Bottom" Style="{StaticResource BotaoSecundario}" Content="Corrigir selecionados" Margin="0,8,0,0" Visibility="Collapsed"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Achados" Margin="0,0,9,0"/>
              </ScrollViewer>
            </DockPanel>

            <DockPanel x:Name="VisaoOtimizar" Grid.Column="0" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Border CornerRadius="12" Background="#26F87171" BorderBrush="#66F87171" BorderThickness="1" Padding="16,10" Margin="0,0,0,8">
                  <StackPanel>
                    <CheckBox x:Name="OpcaoVBS" Style="{StaticResource CaixaTitulo}" Foreground="{StaticResource Texto}" Content="Opcional: desligar Integridade de Memória (VBS/HVCI)"/>
                    <TextBlock Foreground="#FCA5A5" FontSize="11.5" TextWrapping="Wrap" Margin="27,4,0,0" Text="Único ajuste com ganho medido em testes independentes, mas reduz a proteção contra malware e a Riot pede VBS para o Vanguard."/>
                  </StackPanel>
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="Simular" Style="{StaticResource BotaoSecundario}" Content="Simular e ver o plano"/>
                  <Button x:Name="Reverter" Grid.Column="2" Style="{StaticResource BotaoSecundario}" Content="Reverter tudo"/>
                </Grid>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Perfis" Margin="0,0,9,4"/>
              </ScrollViewer>
            </DockPanel>

            <ScrollViewer x:Name="VisaoFerramentas" Grid.Column="0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="Ferramentas" Margin="0,0,9,0"/>
            </ScrollViewer>

            <Grid x:Name="MolduraEtapas" Grid.Column="0" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="12" Background="{StaticResource Painel}" BorderBrush="{StaticResource BordaVidro}" BorderThickness="1" Padding="15,11">
                <ScrollViewer x:Name="RolagemEtapas" VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="Etapas" Margin="0,0,8,0"/>
                </ScrollViewer>
              </Border>
              <Border Grid.Row="2" CornerRadius="12" Background="#E6050810" BorderBrush="{StaticResource BordaVidro}" BorderThickness="1">
                <RichTextBox x:Name="Terminal" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto2}" CaretBrush="#22D3EE" SelectionBrush="#22D3EE" FontSize="11.5" Padding="8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"/>
              </Border>
            </Grid>

            <!-- HUD -->
            <Border Grid.Column="2" CornerRadius="14" Background="{StaticResource Painel}" BorderBrush="{StaticResource BordaVidro}" BorderThickness="1" Padding="18,14">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                  <TextBlock x:Name="NumeroGrande" Text="000" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Marca}" FontSize="44" FontWeight="Bold"/>
                  <TextBlock x:Name="LegendaGrande" Text="módulos selecionados" Foreground="{StaticResource Texto2}" FontSize="12.5"/>
                  <ProgressBar x:Name="Barra" Margin="0,11,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,8">
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                      <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7" Margin="4"/>
                      <Path x:Name="AnelCpu" Stroke="#22D3EE" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/></Path.Effect>
                      </Path>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ValorCpu" Text="--" FontFamily="{StaticResource Mono}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="CPU" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto3}" FontSize="10" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1" Width="96" Height="96" HorizontalAlignment="Center">
                      <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7" Margin="4"/>
                      <Path x:Name="AnelRam" Stroke="#8B5CF6" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
                      </Path>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ValorRam" Text="--" FontFamily="{StaticResource Mono}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="RAM" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto3}" FontSize="10" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                  <Canvas Height="30" ClipToBounds="True" Margin="0,0,0,8">
                    <Polyline x:Name="Sparkline" Stroke="{StaticResource Marca}" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                  </Canvas>
                  <TextBlock x:Name="Telemetria" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Texto2}" FontSize="11.5" LineHeight="17"/>
                  <Border BorderBrush="{StaticResource Borda}" BorderThickness="0,1,0,0" Margin="0,10,0,9"/>
                  <TextBlock x:Name="Situacao" Foreground="{StaticResource Texto2}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                  <TextBlock x:Name="Aviso" Foreground="#FBBF24" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                  <Button x:Name="Relatorio" Style="{StaticResource BotaoSecundario}" Content="Ver relatório" Margin="0,0,0,8" Visibility="Collapsed"/>
                  <Button x:Name="Principal" Style="{StaticResource BotaoPrincipal}" Content="Instalar selecionados"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
