<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:Upaiva;assembly=upaiva.dev"
        Title="upaiva.dev" Width="1280" Height="800" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanMinimize" Background="#000000"
        FontFamily="{StaticResource FText}" SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
  <Window.Resources>
    <SolidColorBrush x:Key="Painel" Color="#070707"/>
    <SolidColorBrush x:Key="Painel2" Color="#0C0C0C"/>
    <SolidColorBrush x:Key="Linha" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Linha2" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="Tinta" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Suave" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Mudo" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Fraco" Color="#7A7A7A"/>

    <Style x:Key="Foco">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Stroke="#FFFFFF" StrokeThickness="1" RadiusX="3" RadiusY="3" Margin="-3"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Navegacao superior: rotulo espacado, como no site -->
    <Style x:Key="Aba" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Mudo}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="15,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="Transparent" Padding="0,8">
              <u:TextoTrack Texto="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Tamanho="11.5" Track="2.5" Familia="{StaticResource FLabel}" Cor="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource Tinta}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Tinta}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Selecao multipla: quadrado com check -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Mudo}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Aro" Width="13" Height="13" CornerRadius="3" BorderBrush="#5C5C5C" BorderThickness="1" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="Marca" Data="M1.8,5.4 L4.4,8 L9.2,2.8" Stroke="#000000" StrokeThickness="1.5" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Aro" Property="BorderBrush" Value="#D4D4D4"/>
                <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Aro" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="Aro" Property="BorderBrush" Value="#FFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Suave}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pilula branca com seta: a acao principal, como CONTATO no site -->
    <Style x:Key="BotaoPrincipal" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" CornerRadius="21" Background="#FFFFFF" Padding="22,0" RenderTransformOrigin="0.5,0.5">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <u:TextoTrack Texto="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Tamanho="11.5" Track="2.3" Familia="{StaticResource FLabel}" Caixa="True" Cor="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
                <Path x:Name="Seta" Data="M0.5,8.5 L8.5,0.5 M2.2,0.5 L8.5,0.5 L8.5,6.8" Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.2" Margin="9,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#D4D4D4"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Fundo" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="Tag" Value="sem"><Setter TargetName="Seta" Property="Visibility" Value="Collapsed"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Fundo" Property="Background" Value="#141414"/>
                <Setter TargetName="Seta" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{StaticResource Fraco}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pilula de contorno -->
    <Style x:Key="BotaoPilula" TargetType="Button">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Suave}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" CornerRadius="16" Background="Transparent" BorderBrush="{StaticResource Linha2}" BorderThickness="1" Padding="14,0">
              <u:TextoTrack Texto="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Tamanho="10.5" Track="2" Familia="{StaticResource FLabel}" Caixa="True" Cor="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="BorderBrush" Value="#8C8C8C"/>
                <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fundo" Property="Background" Value="#141414"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource Fraco}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoJanela" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Mudo}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" CornerRadius="15" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Background" Value="#141414"/>
                <Setter Property="Foreground" Value="{StaticResource Tinta}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nivel: linha superior que acende, como os quatro passos do site -->
    <Style x:Key="Nivel" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource Foco}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Border x:Name="Topo" Height="1" Background="{StaticResource Linha2}" VerticalAlignment="Top"/>
              <ContentPresenter Margin="0,16,22,14"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Topo" Property="Background" Value="#8C8C8C"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Topo" Property="Background" Value="#FFFFFF"/>
                <Setter TargetName="Topo" Property="Height" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Border CornerRadius="2" Background="#5C5C5C" Width="3" HorizontalAlignment="Right"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Busca" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/>
      <Setter Property="SelectionBrush" Value="#8C8C8C"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Background="#000000" BorderBrush="{StaticResource Linha2}" BorderThickness="1">
    <Grid x:Name="Raiz" ClipToBounds="True">
      <u:Planeta x:Name="Planeta" Width="420" Height="168" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,30,0" IsHitTestVisible="False"/>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="66"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <!-- Navegacao -->
        <Grid x:Name="Topo" Grid.Row="0" Background="Transparent" Margin="36,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <u:TextoTrack Texto="upaiva.dev" Tamanho="23" Track="-0.7" Familia="{StaticResource FDisplay}" Cor="#FFFFFF" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <RadioButton x:Name="AbaInstalar" Style="{StaticResource Aba}" Tag="INSTALAR" IsChecked="True" GroupName="Abas"/>
            <RadioButton x:Name="AbaDrivers" Style="{StaticResource Aba}" Tag="DRIVERS" GroupName="Abas"/>
            <RadioButton x:Name="AbaAnalisar" Style="{StaticResource Aba}" Tag="ANALISAR" GroupName="Abas"/>
            <RadioButton x:Name="AbaOtimizar" Style="{StaticResource Aba}" Tag="OTIMIZAR" GroupName="Abas"/>
            <RadioButton x:Name="AbaFerramentas" Style="{StaticResource Aba}" Tag="FERRAMENTAS" GroupName="Abas"/>
            <RadioButton x:Name="AbaTerminal" Style="{StaticResource Aba}" Tag="TERMINAL" GroupName="Abas"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="AbrirPaleta" Style="{StaticResource BotaoPilula}" Content="&gt;_  Ctrl K" Margin="0,0,10,0"/>
            <Button x:Name="Minimizar" Style="{StaticResource BotaoJanela}" Content="&#xE921;" AutomationProperties.Name="Minimizar"/>
            <Button x:Name="Fechar" Style="{StaticResource BotaoJanela}" Content="&#xE8BB;" AutomationProperties.Name="Fechar"/>
          </StackPanel>
        </Grid>

        <!-- Cabecalho da secao -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Margin="36,0" Padding="0,24,0,20">
          <StackPanel Orientation="Horizontal">
            <u:TextoTrack x:Name="NumeroSecao" Texto="01" Tamanho="58" Track="-2" Familia="{StaticResource FThin}" Cor="#FFFFFF" Width="104" Margin="0,-6,0,0"/>
            <StackPanel>
              <u:TextoTrack x:Name="RotuloSecao" Texto="" Tamanho="10.5" Track="3" Familia="{StaticResource FLabel}" Cor="#8C8C8C" Caixa="True" Margin="1,2,0,12"/>
              <u:TextoTrack x:Name="Titulo1" Texto="" Tamanho="42" Track="-1.5" Familia="{StaticResource FDisplay}" Cor="#FFFFFF"/>
              <u:TextoTrack x:Name="Titulo2" Texto="" Tamanho="42" Track="-1.5" Familia="{StaticResource FDisplay}" Cor="#8C8C8C"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Conteudo -->
        <Grid x:Name="Conteudo" Grid.Row="2" Margin="36,0,30,0">

          <DockPanel x:Name="VisaoInstalar">
            <Grid DockPanel.Dock="Top" Margin="0,0,6,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border BorderThickness="0,0,0,1" Margin="0,0,24,0" Height="32">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{StaticResource Linha2}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Busca}" Value="True"><Setter Property="BorderBrush" Value="#FFFFFF"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <TextBlock x:Name="DicaBusca" Text="buscar programa" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{StaticResource Fraco}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  <TextBox x:Name="Busca" Style="{StaticResource Busca}" AutomationProperties.Name="Buscar programa"/>
                </Grid>
              </Border>
              <StackPanel x:Name="Perfis" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Grid>
            <ScrollViewer x:Name="RolagemGrupos" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Grupos" Margin="0,0,14,0"/>
            </ScrollViewer>
          </DockPanel>

          <DockPanel x:Name="VisaoDrivers" Visibility="Collapsed">
            <TextBlock x:Name="ResumoDrivers" DockPanel.Dock="Top" FontSize="13" Foreground="{StaticResource Mudo}" Margin="0,0,0,10" Text="Ainda sem busca. A fonte é o catálogo oficial do Windows Update, que prioriza estabilidade."/>
            <Button x:Name="BuscarDeNovo" DockPanel.Dock="Bottom" Style="{StaticResource BotaoPilula}" Content="Buscar de novo" HorizontalAlignment="Left" Margin="0,10,0,10" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ListaDrivers" Margin="0,0,14,0"/>
            </ScrollViewer>
          </DockPanel>

          <DockPanel x:Name="VisaoAnalisar" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,14,10">
              <CheckBox x:Name="Profundo" DockPanel.Dock="Right" Content="Análise profunda com sfc /verifyonly"/>
              <TextBlock x:Name="ResumoAnalise" FontSize="13" Foreground="{StaticResource Mudo}" VerticalAlignment="Center" Text="Ainda sem análise. Só lê: nada muda sem você marcar."/>
            </DockPanel>
            <Button x:Name="AnalisarDeNovo" DockPanel.Dock="Bottom" Style="{StaticResource BotaoPilula}" Content="Analisar de novo" HorizontalAlignment="Left" Margin="0,10,0,10" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Achados" Margin="0,0,14,0"/>
            </ScrollViewer>
          </DockPanel>

          <StackPanel x:Name="VisaoOtimizar" Visibility="Collapsed" Margin="0,0,6,0">
            <TextBlock Foreground="{StaticResource Mudo}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,18" Text="Nenhum nível toca em Defender, Firewall, UAC, Windows Update, TPM ou Secure Boot. Cada um inclui o anterior. Ganho de desempenho não é garantido."/>
            <UniformGrid x:Name="Niveis" Rows="1"/>
            <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,20,0,0">
              <StackPanel>
                <CheckBox x:Name="OpcaoVBS" Content="Desligar Integridade de Memória (VBS/HVCI). Único ajuste com ganho medido, mas reduz a proteção e a Riot pede VBS."/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button x:Name="Simular" Style="{StaticResource BotaoPilula}" Content="Simular o plano" Margin="0,0,8,0"/>
                  <Button x:Name="Reverter" Style="{StaticResource BotaoPilula}" Content="Reverter tudo"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <ScrollViewer x:Name="VisaoFerramentas" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel x:Name="Ferramentas" Margin="0,0,14,0"/>
          </ScrollViewer>

          <Grid x:Name="VisaoTerminal" Visibility="Collapsed" Margin="0,0,6,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4*"/>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="RolagemEtapas" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="Etapas" Margin="0,0,10,0"/>
            </ScrollViewer>
            <Border Grid.Column="2" CornerRadius="16" Background="#050505" BorderBrush="{StaticResource Linha2}" BorderThickness="1">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="16,11">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#FFFFFF"/>
                    <Ellipse Width="7" Height="7" Fill="#2A2A2A" Margin="5,0"/>
                    <Ellipse Width="7" Height="7" Stroke="#2A2A2A" StrokeThickness="1" Margin="0,0,12,0"/>
                    <TextBlock Text="upaiva@windows: ~" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource Mudo}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <RichTextBox x:Name="Terminal" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource Mudo}" CaretBrush="#FFFFFF" SelectionBrush="#8C8C8C" FontSize="11.5" Padding="12,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden"/>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Rodape: telemetria real e acao principal -->
        <Grid Grid.Row="3" Margin="36,0">
          <Border Height="1" Background="{StaticResource Linha}" VerticalAlignment="Top"/>
          <Border x:Name="BarraProgresso" Height="1" Background="#FFFFFF" VerticalAlignment="Top" HorizontalAlignment="Left" Width="0"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Telemetria" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource Mudo}" VerticalAlignment="Center"/>
            <TextBlock x:Name="Aviso" Grid.Column="1" Foreground="#FF6B6B" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="26,0,20,0" Visibility="Collapsed"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox x:Name="OpcaoParalelo" Content="Em paralelo" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed" ToolTip="Instala vários programas juntos enquanto CPU e RAM permitem. Instaladores MSI esperam a vez."/>
              <Button x:Name="Relatorio" Style="{StaticResource BotaoPilula}" Content="Ver relatório" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Button x:Name="Cancelar" Style="{StaticResource BotaoPilula}" Content="Cancelar" Margin="0,0,8,0" Visibility="Collapsed"/>
              <Button x:Name="Principal" Style="{StaticResource BotaoPrincipal}" Content="Instalar"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <!-- Paleta de comandos, como o terminal Ctrl K do site -->
      <Grid x:Name="Paleta" Background="#CC000000" Visibility="Collapsed">
        <Border Width="660" Height="400" CornerRadius="22" Background="#050505" BorderBrush="{StaticResource Linha2}" BorderThickness="1">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="18,12">
              <DockPanel>
                <Button x:Name="FecharPaleta" DockPanel.Dock="Right" Style="{StaticResource BotaoPilula}" Content="esc" Height="26"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#FFFFFF"/>
                  <Ellipse Width="7" Height="7" Fill="#2A2A2A" Margin="5,0"/>
                  <Ellipse Width="7" Height="7" Stroke="#2A2A2A" StrokeThickness="1" Margin="0,0,12,0"/>
                  <TextBlock Text="upaiva@windows: ~" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource Mudo}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Padding="18,12">
              <StackPanel x:Name="AtalhosPaleta" Orientation="Horizontal"/>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="18,6,18,10">
              <TextBlock DockPanel.Dock="Left" Text="~ $" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{StaticResource Mudo}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBox x:Name="EntradaPaleta" Style="{StaticResource Busca}" AutomationProperties.Name="Comando"/>
            </DockPanel>
            <StackPanel x:Name="ResultadosPaleta" Margin="18,14,18,0"/>
          </DockPanel>
        </Border>
      </Grid>

      <Grid x:Name="Confirma" Background="#CC000000" Visibility="Collapsed">
        <Border Width="560" VerticalAlignment="Center" CornerRadius="22" Background="#050505" BorderBrush="{StaticResource Linha2}" BorderThickness="1">
          <StackPanel>
            <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="18,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#FFFFFF"/>
                <Ellipse Width="7" Height="7" Fill="#2A2A2A" Margin="5,0"/>
                <Ellipse Width="7" Height="7" Stroke="#2A2A2A" StrokeThickness="1" Margin="0,0,12,0"/>
                <TextBlock Text="upaiva@windows: ~" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{StaticResource Mudo}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="22,22,22,20">
              <u:TextoTrack x:Name="ConfirmaTitulo" Texto="" Tamanho="28" Track="-0.8" Familia="{StaticResource FDisplay}" Cor="#FFFFFF" Margin="0,0,0,10"/>
              <TextBlock x:Name="ConfirmaTexto" Foreground="{StaticResource Mudo}" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,22"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ConfirmaNao" Style="{StaticResource BotaoPilula}" Content="Voltar" Height="42" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmaSim" Style="{StaticResource BotaoPrincipal}" Tag="sem"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
